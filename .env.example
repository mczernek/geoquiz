# Supabase project (Dashboard → Project Settings → API). Without these the app works offline-only, no sync.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google sign-in (docs/release.md → Google). Without them the "Continue with Google" button is hidden.
# Web client id (Google Cloud → Google Auth Platform → Clients → Web application). Web and Android need it; Android
# and iOS ask Google for an ID token issued to it, which Supabase's Google provider accepts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id (same Clients page → iOS). iOS needs it too, plus its reversed form as `iosUrlScheme` in app.json.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
