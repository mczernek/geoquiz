{
  "expo": {
    "name": "Globik",
    "slug": "geoquiz",
    "version": "1.1.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "geoquiz",
    "userInterfaceStyle": "light",
    "backgroundColor": "#7A06F8",
    "ios": {
      "bundleIdentifier": "com.michalczernek.geoquiz",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.michalczernek.geoquiz",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#7A06F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Globik",
      "shortName": "Globik",
      "themeColor": "#7A06F8",
      "backgroundColor": "#7A06F8",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7A06F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
